# 生产环境变量样板
# 生产与部署环境不依赖 rewrite，直接通过平台注入 NEXT_PUBLIC_* 变量

NEXT_PUBLIC_API_URL=https://api.booking.example.com/v1
NEXT_PUBLIC_WS_URL=wss://api.booking.example.com
NEXT_PUBLIC_INSTANCE_NAME=prod

# Salesforce 管理工作台（P0-4・RULE-16/RULE-18）・公开 URL（无凭据）
# 下例为 dev 组织地址・生产部署时替换为实际 Experience Cloud 站点登录页
NEXT_PUBLIC_SF_SITE_URL=https://<your-site>.my.site.com/<site-prefix>/login
