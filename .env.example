# 本地开发环境变量样板
# 开发环境优先使用 Next.js rewrite，因此这里保留默认 API 配置作为兜底
# ホストは 127.0.0.1 を指定する。'localhost' は環境によって IPv6(::1) に解決され、
# バックエンドが接続する Redis とずれることがある。

NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/v1
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3001
NEXT_PUBLIC_INSTANCE_NAME=local

# Salesforce 管理工作台（P0-4・RULE-16/RULE-18）・公开 URL（无凭据）
NEXT_PUBLIC_SF_SITE_URL=https://softcode-dev-ed.develop.my.site.com/02/login
